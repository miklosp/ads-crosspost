{
  "name": "ads-crosspost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "post": "node src/cli.ts post",
    "login": "node src/cli.ts login",
    "discover": "node src/cli.ts discover",
    "import-data": "node src/import.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "app:build": "rm -rf out && tsc -p tsconfig.app.json && cp src/platforms/*.json out/src/platforms/ && mkdir -p out/src/prompts && cp src/prompts/*.md out/src/prompts/",
    "app:dev": "pnpm app:build && electron .",
    "app:smoke": "pnpm app:build && node scripts/smoke.ts",
    "app:dist": "pnpm app:build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "app:dist:signed": "pnpm app:build && scripts/with-apple-key.sh electron-builder --mac dmg --arm64 --x64 \"-c.mac.identity=Miklos Petravich (V378YWVH44)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "fflate": "^0.8.3",
    "heic-decode": "^2.1.0",
    "patchright": "^1.55.0",
    "sharp": "^0.34.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2"
  },
  "main": "out/app/main.js",
  "build": {
    "appId": "io.github.adscrosspost.app",
    "productName": "Ads Crosspost",
    "files": [
      "out/**",
      "app/assets/**",
      "app/index.html",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/patchright/**",
      "node_modules/patchright-core/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true
      },
      "notarize": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
